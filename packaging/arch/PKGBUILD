# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oomenubar-bin
_pkgname=oomenubar
pkgver=0.1.0
pkgrel=1
pkgdesc="Renders sovereign status bars with dynamic telemetry widgets and oote colors."
arch=('x86_64')
url="https://github.com/openOODA-tools/oomenubar"
license=('Apache-2.0')
depends=('glibc')
provides=('oomenubar')
conflicts=('oomenubar')
source_x86_64=("${url}/releases/download/v${pkgver}/oomenubar-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oomenubar-linux-x86_64" "${pkgdir}/usr/bin/oomenubar"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oomenubar-uninstall"
}
